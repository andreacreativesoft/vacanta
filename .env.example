# Anthropic API key for the in-app chat assistant.
ANTHROPIC_API_KEY=

# Travelpayouts credentials. Same token works for hotels (Hotellook) and
# flights (Aviasales month-matrix). Sign up at https://www.travelpayouts.com/.
TRAVELPAYOUTS_TOKEN=
TRAVELPAYOUTS_MARKER=

# Local SQLite path (used when TURSO_DATABASE_URL is unset).
DATABASE_URL=./data/vacation-finder.db

# Turso credentials for the Vercel deploy. Leave unset for local-only dev.
# TURSO_DATABASE_URL=libsql://...
# TURSO_AUTH_TOKEN=...
