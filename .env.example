# Anthropic API key for the in-app chat assistant.
# Required for /searches/[id] chat panel and Phase 7 features.
ANTHROPIC_API_KEY=

# Travelpayouts (Hotellook) credentials.
# Sign up at https://www.travelpayouts.com/ to obtain.
# While these are empty, the hotel pricing layer falls back to mock data.
TRAVELPAYOUTS_TOKEN=
TRAVELPAYOUTS_MARKER=

# Path to the SQLite database file (resolved relative to project root).
DATABASE_URL=./data/vacation-finder.db
